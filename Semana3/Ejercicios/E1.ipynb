#Hallar el maximo valor de un arreglo no ordenado, dividiendo el arreglo en dos partes y comparando los maximos de cada parte

def maximo(A):
    if len(A) == 1:
        return A[0]
    else:
        m = len(A)//2
        max1 = maximo(A[:m])
        max2 = maximo(A[m:])
        return max(max1, max2)
    
A = [1, 19, 45, 10, 23]
print(maximo(A))